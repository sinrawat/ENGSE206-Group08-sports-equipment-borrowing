<mxfile host="app.diagrams.net"><diagram name="context-after" id="context-after"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1110" pageHeight="860" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="A" value="&lt;b&gt;ผู้ยืม / ชมรม / ผู้จัดกิจกรรม&lt;/b&gt;&lt;br&gt;&lt;font color=&#x27;#173B65&#x27;&gt;&lt;b&gt;[Actor · Core]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&#x27;#222222&#x27;&gt;ยืมอุปกรณ์ · ดูสถานะ&lt;/font&gt;&lt;br&gt;&lt;font color=&#x27;#222222&#x27;&gt;รับแจ้งเตือน (ถ้า opt-in)&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;verticalAlign=top;align=center;fillColor=#EEF1F5;strokeColor=#173B65;strokeWidth=2;fontColor=#173B65;" vertex="1" parent="1"><mxGeometry x="20" y="94" width="250" height="160" as="geometry"/></mxCell><mxCell id="K" value="&lt;b&gt;ผู้ดูแลอุปกรณ์&lt;/b&gt;&lt;br&gt;&lt;font color=&#x27;#173B65&#x27;&gt;&lt;b&gt;[Actor · Core]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&#x27;#222222&#x27;&gt;ตรวจและยืนยันรับคืน (AC-06)&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;verticalAlign=top;align=center;fillColor=#EEF1F5;strokeColor=#173B65;strokeWidth=2;fontColor=#173B65;" vertex="1" parent="1"><mxGeometry x="20" y="364" width="250" height="160" as="geometry"/></mxCell><mxCell id="S" value="&lt;font color=&#x27;#C0392B&#x27;&gt;&lt;b&gt;[★ เปลี่ยน]&lt;/b&gt;&lt;/font&gt; &lt;b&gt;ระบบยืม–คืนอุปกรณ์&lt;/b&gt;&lt;br&gt;&lt;font color=&#x27;#087E8B&#x27;&gt;&lt;b&gt;[System · Core + Extension]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&#x27;#222222&#x27;&gt;ขอบเขตที่ Group08 สร้าง&lt;/font&gt;&lt;br&gt;&lt;font color=&#x27;#222222&#x27;&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&#x27;#222222&#x27;&gt;ที่เปลี่ยนจาก CR-FX-01:&lt;/font&gt;&lt;br&gt;&lt;font color=&#x27;#222222&#x27;&gt;• แจ้งสถานะในระบบ&lt;/font&gt;&lt;br&gt;&lt;font color=&#x27;#222222&#x27;&gt;   Build now (FR-FX-01)&lt;/font&gt;&lt;br&gt;&lt;font color=&#x27;#222222&#x27;&gt;• เตือนกำหนดคืน&lt;/font&gt;&lt;br&gt;&lt;font color=&#x27;#222222&#x27;&gt;   Overview (OI-FX-02)&lt;/font&gt;&lt;br&gt;&lt;font color=&#x27;#222222&#x27;&gt;• opt-in / consent&lt;/font&gt;&lt;br&gt;&lt;font color=&#x27;#222222&#x27;&gt;   Overview (FR-FX-03)&lt;/font&gt;&lt;br&gt;&lt;font color=&#x27;#222222&#x27;&gt;• ส่งออกภายนอก&lt;/font&gt;&lt;br&gt;&lt;font color=&#x27;#222222&#x27;&gt;   Later (OI-FX-01/03/04)&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;verticalAlign=top;align=center;fillColor=#E3F1F3;strokeColor=#087E8B;strokeWidth=2;fontColor=#173B65;" vertex="1" parent="1"><mxGeometry x="430" y="94" width="250" height="430" as="geometry"/></mxCell><mxCell id="E" value="&lt;font color=&#x27;#C0392B&#x27;&gt;&lt;b&gt;[★ ใหม่]&lt;/b&gt;&lt;/font&gt; &lt;b&gt;ช่องทางแจ้งเตือนภายนอก&lt;/b&gt;&lt;br&gt;&lt;font color=&#x27;#B7791F&#x27;&gt;&lt;b&gt;[External · Extension · TBD]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&#x27;#222222&#x27;&gt;provider / ผู้ควบคุม / protocol&lt;/font&gt;&lt;br&gt;&lt;font color=&#x27;#222222&#x27;&gt;TBD (OI-FX-01) · ใช้จริง = Later&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;verticalAlign=top;align=center;fillColor=#FFF4DC;strokeColor=#B7791F;strokeWidth=2;fontColor=#173B65;dashed=1;" vertex="1" parent="1"><mxGeometry x="840" y="204" width="250" height="200" as="geometry"/></mxCell><mxCell id="e0" value="① ยืม / ดูสถานะ" style="edgeStyle=none;html=1;endArrow=classic;endFill=1;strokeWidth=2;strokeColor=#173B65;fontColor=#173B65;fontStyle=1;labelBackgroundColor=#FFFFFF;exitX=1.0000;exitY=0.2500;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.0930;entryDx=0;entryDy=0;" edge="1" parent="1" source="A" target="S"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e1" value="② ผลยืม+แจ้งในระบบ" style="edgeStyle=none;html=1;endArrow=classic;endFill=1;strokeWidth=2;strokeColor=#173B65;fontColor=#173B65